# PagueloFacil Merchant Environment Variable (Configure in Netlify: Site Settings > Environment Variables)
# PAGUELOFACIL_CCLW is your PagueloFacil Company/Merchant Secret Key (CCLW token).
# DO NOT commit secret keys or values to version control.
PAGUELOFACIL_CCLW=
PAGUELOFACIL_ENVIRONMENT=sandbox
PAGUELOFACIL_SANDBOX_URL=https://sandbox.paguelofacil.com
PAGUELOFACIL_PRODUCTION_URL=https://secure.paguelofacil.com
SITE_URL=https://dubgan.netlify.app
